{
  "name": "ras-agentica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/finalize-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src tests scripts public/sw.js *.ts *.json *.md"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
